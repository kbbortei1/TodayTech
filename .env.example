# ─────────────────────────────────────────────────────────────
# TodayTech — Environment Variables
# Copy this file to .env and fill in YOUR values.
# NEVER commit your .env — it is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram and paste the token.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your numeric Telegram user ID (the bot only responds to this).
# Send /start to @userinfobot on Telegram to find it.
TELEGRAM_USER_ID=your-numeric-user-id-here

# ── Search APIs (at least ONE is required) ────────────────────
# Get free keys from the respective provider dashboards.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
SERPER_API_KEY=
SERPAPI_API_KEY=

# ── LLM Providers (at least ONE is required) ──────────────────
# Gemini free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Local Ollama (no key needed, just set the base URL)
OLLAMA_BASE_URL=http://localhost:11434

# ── Reddit (optional) ────────────────────────────────────────
# Create a Reddit app at https://www.reddit.com/prefs/apps/
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TodayTech/1.0

# ── Telegram Channels (optional, for Telethon) ───────────────
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── Email Ingestion (optional) ───────────────────────────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ── Database (default: SQLite in data/) ──────────────────────
# Set to a Postgres URL to use Postgres instead.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/todaytech
DATABASE_URL=sqlite+aiosqlite:///data/todaytech.db

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
